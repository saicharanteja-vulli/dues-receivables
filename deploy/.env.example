DUES_DOMAIN=dues.example.com
DUES_PUBLIC_ORIGIN=https://dues.example.com
DUES_STORAGE_MB=100
DUES_MAX_USERS=100
DUES_MAIL_MODE=local
# Set privately before enabling SMTP. Do not commit this file with credentials.
# DUES_MAIL_MODE=smtp
# DUES_SMTP_HOST=smtp.example.com
# DUES_SMTP_PORT=587
# DUES_SMTP_FROM=accounts@example.com
# DUES_SMTP_USER=
# DUES_SMTP_PASSWORD=
# A Fernet key enables daily encrypted backups. Keep a separate offline copy.
# DUES_BACKUP_KEY=
